rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // Developer identity: the email must be on the list AND must not be
    // explicitly unverified. `!= false` (instead of `== true`) keeps Microsoft
    // tokens that omit the claim working, while still blocking a self-created
    // unverified email/password account from claiming a developer address.
    function isDeveloper() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified != false
        && authEmail() in [
          'albertaparks1t@gmail.com',
          'bachasalman69@gmail.com',
          'taybekraa@gmail.com',
          'kraakraa109@gmail.com'
        ];
    }

    // ── Per-client private data ─────────────────────────────────────────────
    match /clients/{clientId} {
      function isOwnerClientEmail() {
        return isSignedIn() && resource.data.email is string
          && resource.data.email.lower() == authEmail();
      }
      function writesOwnClientEmail() {
        return isSignedIn() && request.resource.data.email is string
          && request.resource.data.email.lower() == authEmail();
      }
      function ownerMayCreateOwn() {
        return writesOwnClientEmail()
          && (!('plan' in request.resource.data)
              || request.resource.data.plan == 'free')
          && (!('planExpiry' in request.resource.data)
              || request.resource.data.planExpiry == null);
      }
      function ownerMayUpdateOwn() {
        return isOwnerClientEmail() && writesOwnClientEmail()
          && (!('plan' in request.resource.data)
              || request.resource.data.plan == 'free'
              || (('plan' in resource.data)
                  && request.resource.data.plan == resource.data.plan))
          && (!('planExpiry' in request.resource.data)
              || request.resource.data.planExpiry == null
              || (('planExpiry' in resource.data)
                  && request.resource.data.planExpiry == resource.data.planExpiry));
      }
      allow get: if isDeveloper() || isOwnerClientEmail();
      allow list: if isDeveloper() || (isSignedIn() && resource.data.email == authEmail());
      allow create: if isDeveloper() || ownerMayCreateOwn();
      allow update: if isDeveloper() || ownerMayUpdateOwn();
      allow delete: if isDeveloper();
    }

    // Per-account UI preferences (hidden suggestions, view state). Keyed by uid.
    match /userPreferences/{userId} {
      allow get, list: if isDeveloper() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isDeveloper() || (isSignedIn() && request.auth.uid == userId);
    }

    // Payment sessions hold amounts and provider session ids — owner only.
    match /payment_sessions/{sessionId} {
      allow get: if isDeveloper()
        || (isSignedIn() && resource.data.buyerEmail is string
            && resource.data.buyerEmail.lower() == authEmail());
      allow list: if isDeveloper()
        || (isSignedIn() && resource.data.buyerEmail is string
            && resource.data.buyerEmail.lower() == authEmail());
      allow create: if isDeveloper()
        || (isSignedIn() && request.resource.data.buyerEmail is string
            && request.resource.data.buyerEmail.lower() == authEmail());
      allow update: if isDeveloper()
        || (isSignedIn()
            && resource.data.buyerEmail is string
            && request.resource.data.buyerEmail is string
            && resource.data.buyerEmail.lower() == authEmail()
            && request.resource.data.buyerEmail.lower() == authEmail());
      allow delete: if isDeveloper()
        || (isSignedIn() && resource.data.buyerEmail is string
            && resource.data.buyerEmail.lower() == authEmail());
    }

    // Bot purchase ledger — owner + developer.
    match /store_purchases/{purchaseId} {
      allow get: if isDeveloper()
        || (isSignedIn() && resource.data.email is string
            && resource.data.email.lower() == authEmail());
      allow list: if isDeveloper()
        || (isSignedIn() && resource.data.email == authEmail());
      allow create: if isDeveloper()
        || (isSignedIn() && request.resource.data.email is string
            && request.resource.data.email.lower() == authEmail());
      allow update, delete: if isDeveloper();
    }

    // ── Plan grants: developer-created only ─────────────────────────────────
    match /payment_grants/{grantId} {
      allow get: if true;
      allow list: if isDeveloper()
        || (isSignedIn() && resource.data.email == authEmail());
      allow create: if isDeveloper();
      allow update: if isDeveloper()
        || (isSignedIn()
            && resource.data.email is string
            && request.resource.data.email is string
            && resource.data.email.lower() == authEmail()
            && request.resource.data.email.lower() == authEmail()
            && request.resource.data.status in ['active', 'revoked', 'consumed']
            && resource.data.kind == request.resource.data.kind
            && (!('durationDays' in request.resource.data)
                || (('durationDays' in resource.data)
                    && request.resource.data.durationDays == resource.data.durationDays))
            && (!('expiryDate' in request.resource.data)
                || (('expiryDate' in resource.data)
                    && request.resource.data.expiryDate == resource.data.expiryDate))
            && ('activatedAt' in resource.data
                ? request.resource.data.activatedAt == resource.data.activatedAt
                : (!('activatedAt' in request.resource.data)
                    || (request.resource.data.activatedAt is timestamp
                        && request.resource.data.activatedAt <= request.time
                        && request.time - duration.value(5, 'm') <= request.resource.data.activatedAt)))
            && (!('createdAt' in resource.data)
                || request.resource.data.createdAt == resource.data.createdAt)
            && (!('requestNo' in resource.data)
                || request.resource.data.requestNo == resource.data.requestNo)
            && (!('planLabel' in resource.data)
                || request.resource.data.planLabel == resource.data.planLabel));
      allow delete: if isDeveloper();
    }

    // Payment requests: the server creates them without a session, so create
    // stays open. Only the developer can decide (update/delete of others).
    match /payment_requests/{requestId} {
      allow get: if true;
      allow list: if isDeveloper()
        || (isSignedIn() && resource.data.buyerEmail is string
            && resource.data.buyerEmail.lower() == authEmail());
      allow create: if request.resource.data.buyerEmail is string;
      allow update: if isDeveloper();
      allow delete: if isDeveloper()
        || (isSignedIn() && resource.data.buyerEmail is string
            && resource.data.buyerEmail.lower() == authEmail());
    }

    // Developer notifications — only the developer reads them. The server's
    // payment endpoints still write them without a session, so writes stay open
    // (worst case is notification spam, never money or plans).
    match /dev_notifications/{notifId} {
      allow read: if isDeveloper();
      allow write: if true;
    }

    // ── Shared AI key pool — ciphertext only, developer-written ─────────────
    match /shared_ai_keys/{keyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isDeveloper();
    }

    // ── Virtual trading: per-uid ────────────────────────────────────────────
    match /paper_accounts/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /paper_trades/{tradeId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PUBLIC DATA — READ IS PUBLIC, WRITE IS DEVELOPER-ONLY
    // ═══════════════════════════════════════════════════════════════════════
    // These collections are polled by every client, so reads must stay open.
    // Writes were `if true`, which let any visitor inject fake signals, fake
    // alerts, fake grants and even rewrite the payment wallet addresses.

    // Kill-switches and site config (ads code, mirror flag).
    // Public read, developer write. This is what closes the stored-XSS hole:
    // AdsManager injects `config/site_ads` with innerHTML, so a world-writable
    // config meant every visitor could inject script into every other visitor.
    match /config/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isDeveloper();
    }

    // Signals broadcast to clients.
    match /shared_results/{docId} {
      allow get, list: if true;
      allow write: if isDeveloper();
    }

    // Auto-trade / alert settings broadcast to clients.
    match /shared_alerts/{docId} {
      allow get, list: if true;
      allow write: if isDeveloper();
    }

    // Grant/status mirror that clients poll. This one is critical: the client
    // reads `shared_status/grant_*` and trusts it as an active plan, so an open
    // write was a free-plan bypass for anyone.
    match /shared_status/{docId} {
      allow get, list: if true;
      allow write: if isDeveloper();
    }

    // ── Copy-trading broadcast channel ──────────────────────────────────────
    // Clients may READ trade events and execute them; only the developer may
    // publish. An open write here would let anyone command every client's
    // account to open/close trades. NOTE: this collection was missing from the
    // deployed rules entirely, so the mirror was silently failing.
    match /shared_trades/{docId} {
      allow get, list: if true;
      allow write: if isDeveloper();
    }

    // Mobile radar shared signals (same model: read public, write developer).
    match /shared_signals/{docId} {
      allow get, list: if true;
      allow write: if isDeveloper();
    }

    // ── shared_settings: mixed public / developer / server docs ─────────────
    // Clients `getDoc` individual documents (freemium, prices, payments,
    // grant_*, ...), but nobody except the developer may LIST the collection:
    // a list would dump every grant, hidden-transaction id and wallet address.
    //
    // Writes are developer-only, with two narrow server-flow exceptions:
    //   1. payment_counter — bumped by /api/payment-request/create, which runs
    //      with the BUYER's token, not the developer's.
    //   2. binance_mail_state — written by the Gmail/Binance poller, which runs
    //      without a Firebase session. Abuse is limited to skipping an email;
    //      it can never touch money or plans.
    // Everything else (payments, prices, grant_*, freemium, clientLogin,
    // dev_hidden_*, removed_default_plans, request_*) is developer-only.
    match /shared_settings/{docId} {
      allow get: if true;
      allow list: if isDeveloper();
      allow write: if isDeveloper()
        || docId == 'payment_counter'
        || docId == 'binance_mail_state';
    }

    // Public store catalogue — developer-only write.
    match /store_plans/{planId} { allow read: if true; allow write: if isDeveloper(); }
    match /store_bots/{botId} { allow read: if true; allow write: if isDeveloper(); }

    // Public suggestion board + shared analysis output.
    // `create` stays open (mobile analysis and suggestions write here) and the
    // owner may delete their own suggestion; the developer may do anything.
    match /analysisResults/{resultId} {
      allow read: if true;
      allow create: if true;
      allow update: if isDeveloper()
        || (isSignedIn() && resource.data._type == 'suggestion'
            && resource.data.votes == request.resource.data.votes);
      allow delete: if isDeveloper()
        || (isSignedIn()
            && resource.data._type == 'suggestion'
            && resource.data.ownerEmail is string
            && resource.data.ownerEmail.lower() == authEmail());
    }
    match /suggestions/{suggestionId} { allow read, write: if true; }

    // Analytics counters are written by every visitor's browser; keep writes
    // open but restrict deletes so a visitor cannot wipe the stats.
    match /analytics_counters/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isDeveloper();
    }
    match /analytics_views/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isDeveloper();
    }
    match /analytics_clicks/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isDeveloper();
    }

    // Processed transaction hashes (replay protection for /api/verify-tx).
    // Immutable once recorded: a hash can be claimed only once, so a buyer
    // cannot reuse an old payment proof for a new purchase.
    match /processed_txs/{txid} {
      allow get: if true;
      allow create: if request.resource.data.txid is string
        && request.resource.data.address is string;
      allow update, delete: if false;
    }

    // Everything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
